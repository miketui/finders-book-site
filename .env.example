# ---------------------------------------------------------------------------
# SECRETS — set these in Vercel > Project > Settings > Environment Variables.
# Never commit real values. Never paste them into chat.
# ---------------------------------------------------------------------------

# MailerLite > Integrations > API  (account 2202141 / warrenjrmd@gmail.com)
MAILERLITE_API_KEY=

# Payhip > Settings > Developer
PAYHIP_API_KEY=

# Random 32+ char string you invent. Appended to the webhook URL as ?t=...
# This is the real defence: Payhip's "signature" is a static value and cannot
# authenticate a payload on its own.
PAYHIP_WEBHOOK_TOKEN=

# At least 32 random bytes in hex. Signs the short-lived download tokens issued
# by /api/gap-check-subscribe and verified by /api/gap-check-download.
# Without it BOTH routes return 503 and the free lead magnet stops working —
# which is the top of the funnel, so it fails quietly and expensively.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GAP_CHECK_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# NON-SECRET — already baked into the code as defaults. Only set these if you
# ever rebuild the groups and the IDs change.
# ---------------------------------------------------------------------------
# ML_GROUP_LEADS=194226608569059081
# ML_GROUP_ESSENTIALS=194226609478173767
# ML_GROUP_ULTIMATE=194226610412455586
# ML_GROUP_FAMILY_BUNDLE=194226611505071661
# ML_GROUP_REFUNDED=194226614527067324

# Contact form routing (api/contact.js). Deliberately separate from Leads:
# a support question must never enter the Gap Check nurture sequence.
# ML_GROUP_CONTACT_QUESTION=195847261261923400
# ML_GROUP_CONTACT_FEEDBACK=195847261915186382
# ML_GROUP_CONTACT_LICENSING=195847263345444315

# Remap Payhip product keys without redeploying:
# PAYHIP_PRODUCT_MAP={"eHcPG":"essentials","Y1O7B":"ultimate","xPuv4":"family_bundle"}

# Defaults shown. Leave alone unless you have a reason.
# RESPECT_EMAIL_CONSENT=true
# REFUND_ON_PARTIAL=false
# MAILERLITE_SUBSCRIBER_STATUS=unconfirmed
