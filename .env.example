# ---------------------------------------------------------------------------
# SECRETS — set these in Vercel > Project > Settings > Environment Variables.
# Never commit real values. Never paste them into chat.
# ---------------------------------------------------------------------------

# MailerLite > Integrations > API (account 2202141; sender-domain authentication is configured separately)
MAILERLITE_API_KEY=

# Payhip > Settings > Developer
PAYHIP_API_KEY=

# Random 32+ char string you invent. Appended to the webhook URL as ?t=...
# This is the real defence: Payhip's "signature" is a static value and cannot
# authenticate a payload on its own.
PAYHIP_WEBHOOK_TOKEN=

# Zero-downtime token rotation: temporarily set a JSON array containing the old
# and new URL tokens, deploy, update Payhip to the new ?t= token, then remove
# the old value and collapse back to PAYHIP_WEBHOOK_TOKEN. While present this
# array overrides the single-token variable in the webhook and health route.
# PAYHIP_WEBHOOK_TOKENS=["old-token","new-token"]

# At least 32 random bytes in hex. Signs the short-lived download tokens issued
# by /api/gap-check-subscribe and verified by /api/gap-check-download.
# Without it BOTH routes return 503 and the free lead magnet stops working —
# which is the top of the funnel, so it fails quietly and expensively.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GAP_CHECK_TOKEN_SECRET=

# GA4 server-side revenue reporting (api/payhip-webhook.js -> lib/ga4.js).
# The browser hands the visitor to Payhip and never learns whether the order
# completed, so `purchase` and `refund` can only be reported from the webhook.
# Leave both blank and the site records checkout clicks but no revenue.
#   GA4_MEASUREMENT_ID: GA4 Admin > Data streams > your web stream ("G-XXXXXXX")
#   GA4_API_SECRET:     same screen > Measurement Protocol API secrets > Create
# Set GA4_DEBUG=true temporarily to send to Google's validation endpoint, which
# reports payload problems instead of recording data. Turn it off afterwards.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# GA4_DEBUG=false

# Required delivery route for inbound contact messages (api/contact.js -> lib/notify.js).
# Any HTTPS endpoint that accepts JSON: a Slack incoming webhook, a Zapier or
# Make catch hook, or your own inbox relay. /api/contact returns an error when
# this is missing or rejects delivery; support contacts are not stored in MailerLite.
CONTACT_NOTIFY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# NON-SECRET — already baked into the code as defaults. Only set these if you
# ever rebuild the groups and the IDs change.
# ---------------------------------------------------------------------------
# ML_GROUP_LEADS=194226608569059081
# ML_GROUP_ALL_CUSTOMERS=194226612687865798
# ML_GROUP_ESSENTIALS=194226609478173767
# ML_GROUP_ULTIMATE=194226610412455586
# ML_GROUP_FAMILY_BUNDLE=194226611505071661
# ML_GROUP_REFUNDED=194226614527067324
# ML_GROUP_REVIEW_REQUESTED=194226613598028898


# Remap Payhip product keys without redeploying:
# PAYHIP_PRODUCT_MAP={"eHcPG":"essentials","Y1O7B":"ultimate","xPuv4":"family_bundle"}

# Defaults shown. Leave alone unless you have a reason.
# RESPECT_EMAIL_CONSENT=true
# REFUND_ON_PARTIAL=false
# MAILERLITE_SUBSCRIBER_STATUS=unconfirmed  # Gap Check lead capture only
